// PencilProof secure audit deployment configuration
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pencilproof-audit",
  "main": "./worker/entry.ts",
  "compatibility_date": "2026-07-26",
  "triggers": {
    "crons": ["0 17 * * 2,5"]
  },
  "keep_vars": true,
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": [
      "/",
      "/account",
      "/account/*",
      "/analyze",
      "/analyze/*",
      "/_next/static/chunks/app/analyze/*",
      "/analytics",
      "/analytics/*",
      "/how-it-works",
      "/how-it-works/*",
      "/phone",
      "/phone/*",
      "/pricing",
      "/pricing/*",
      "/privacy",
      "/privacy/*",
      "/questions",
      "/questions/*",
      "/sales",
      "/sales/*",
      "/terms",
      "/terms/*",
      "/what-it-checks",
      "/what-it-checks/*",
      "/who-it-helps",
      "/who-it-helps/*"
    ]
  },
  "vars": {
    "ACCESS_MAX_AGE_SECONDS": "2592000",
    "PUBLIC_SITE_ORIGIN": "https://pencilproof.com",
    "SITE_ORIGIN": "https://audit.pencilproof.com",
    "STRIPE_PRICE_ID": "price_1Tu1GEEopq0gcXsNeXF2QMry",
    "STRIPE_SALESPERSON_PRICE_ID": "price_1U4rJAEopq0gcXsNNZynvZBO",
    "STRIPE_SALESPERSON_PROMOTION_CODE_ID": "promo_1U4seTEopq0gcXsNEWx8t641",
    "CLERK_ISSUER": "https://clerk.pencilproof.com",
    "CLERK_JWKS_URL": "https://clerk.pencilproof.com/.well-known/jwks.json"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ORDERS",
        "class_name": "OrderStore"
      },
      {
        "name": "ANALYTICS",
        "class_name": "AnalyticsStore"
      },
      {
        "name": "PHONE_SESSIONS",
        "class_name": "PhoneSessionStore"
      },
      {
        "name": "ACCOUNTS",
        "class_name": "AccountStore"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "OrderStore"
      ]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": [
        "AnalyticsStore"
      ]
    },
    {
      "tag": "v3",
      "new_sqlite_classes": [
        "PhoneSessionStore"
      ]
    },
    {
      "tag": "v4",
      "new_sqlite_classes": [
        "AccountStore"
      ]
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
