// PencilProof unattended social-media automation
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pencilproof-social",
  "main": "./worker/social.mjs",
  "compatibility_date": "2026-08-08",
  "workers_dev": true,
  "ai": {
    "binding": "AI"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "SOCIAL_STATE",
        "class_name": "SocialAutomationState"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "SocialAutomationState"
      ]
    }
  ],
  "triggers": {
    "crons": ["*/15 * * * *"]
  },
  "vars": {
    "SOCIAL_AUTOMATION_ENABLED": "true",
    "SOCIAL_REPLY_ENABLED": "true",
    "SOCIAL_PUBLISH_ENABLED": "false",
    "SOCIAL_TIMEZONE": "America/Los_Angeles",
    "SOCIAL_ACTIVE_START_HOUR": "8",
    "SOCIAL_ACTIVE_END_HOUR": "19",
    "SOCIAL_POST_INTERVAL_HOURS": "48",
    "SOCIAL_REPLY_LOOKBACK_DAYS": "14",
    "SOCIAL_MAX_REPLIES_PER_RUN": "4",
    "SOCIAL_MAX_REPLIES_PER_DAY": "12",
    "SOCIAL_AI_MODEL": "@cf/zai-org/glm-4.7-flash"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
